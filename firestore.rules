/**
 * @fileOverview Firestore Security Rules for the AirView application.
 *
 * Core Philosophy:
 * This ruleset prioritizes a secure-by-default posture with path-based ownership for user data and explicit access control for shared resources.
 * It avoids complex `get()` calls by encouraging data denormalization where necessary for authorization.
 *
 * Data Structure:
 * - Users: /users/{userId} - Stores user profiles, accessible only by the user themselves.
 * - Sensors: /sensors/{sensorId} - Stores sensor data.  Potentially shared, but defaults to owner-only access for now.
 * - AirQualityReadings: /sensors/{sensorId}/readings/{readingId} - Air quality readings for each sensor, inherits sensor's access.
 * - AirPurifierDevices: /air_purifier_devices/{deviceId} - Stores air purifier devices. Potentially shared, but defaults to owner-only access for now.
 * - AirPurifierSettings: /users/{userId}/air_purifier_settings/{settingId} - User-specific air purifier settings.
 * - AirQualityPredictions: /sensors/{sensorId}/predictions/{predictionId} - Air quality predictions for each sensor, inherits sensor's access.
 *
 * Key Security Decisions:
 * - Strict user-ownership for data under `/users/{userId}`.
 * - Explicit denial of write access where ownership cannot be validated.
 * - Default to owner-only access for Sensors and AirPurifierDevices unless collaborative access is implemented.
 * - All writes require authentication (`request.auth != null`).
 *
 * Denormalization for Authorization:
 *  - If sensors or air purifier devices need to be shared, add a `members` map (e.g., `{ members: { 'user_abc': 'editor' } }`) to the document.  This allows for performant authorization rules without `get()` calls.
 *
 * Structural Segregation:
 *  - User-specific data (AirPurifierSettings) is stored under the `/users/{userId}` collection to leverage path-based ownership.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile data.
     * @path /users/{userId}
     * @allow (create) - Authenticated user can create their own profile.
     * @allow (get, list, update, delete) - Authenticated user can access their own profile.
     * @deny (create) - Unauthenticated user cannot create a profile.
     * @deny (get, list, update, delete) - Authenticated user cannot access another user's profile.
     * @principle Enforces user ownership of profile data via path-based authorization.
     */
    match /users/{userId} {
      // Helper function to check if the user is signed in and owns the document.
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isSignedIn() && isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false; // Users should not be able to list all user profiles.
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to sensor data.
     * @path /sensors/{sensorId}
     * @allow (get, list) - Anyone can read sensor data.
     * @allow (create, update, delete) - Only the owner can modify sensor data.
     * @deny (create, update, delete) - If not authenticated or not the owner.
     * @principle Public read, owner-only write for sensors.
     */
    match /sensors/{sensorId} {
      function isSignedIn() {
        return request.auth != null;
      }
        // NOTE: This is a placeholder.  In a real application, we would check for sensor ownership.
      function isSensorOwner() {
          return false; // TODO: Replace with actual sensor ownership logic (e.g., checking a members map or ownerId field).
      }
      function isExistingSensorOwner() {
          return isSignedIn() && isSensorOwner() && resource != null;
      }

      allow get, list: if true;
      allow create: if isSignedIn() && isSensorOwner(); // TODO: Implement proper owner check on create.
      allow update: if isExistingSensorOwner();
      allow delete: if isExistingSensorOwner();
    }

    /**
     * @description Controls access to air quality readings for a sensor.
     * @path /sensors/{sensorId}/readings/{readingId}
     * @allow (get, list) - Anyone can read air quality readings.
     * @allow (create, update, delete) - Only the owner of the sensor can modify readings.
     * @deny (create, update, delete) - If not authenticated or not the owner of the sensor.
     * @principle Public read, owner-only write for air quality readings, inheriting sensor's ownership.
     */
    match /sensors/{sensorId}/readings/{readingId} {
      function isSignedIn() {
        return request.auth != null;
      }
        // NOTE: This is a placeholder.  In a real application, we would check for sensor ownership.
      function isSensorOwner() {
          return false; // TODO: Replace with actual sensor ownership logic (e.g., checking a members map or ownerId field).
      }
      function isExistingSensorOwner() {
          return isSignedIn() && isSensorOwner() && resource != null;
      }
      allow get, list: if true;
      allow create: if isSignedIn() && isSensorOwner(); // TODO: Implement proper owner check on create.
      allow update: if isExistingSensorOwner();
      allow delete: if isExistingSensorOwner();
    }

    /**
     * @description Controls access to air purifier device data.
     * @path /air_purifier_devices/{deviceId}
     * @allow (get, list) - Anyone can read device data.
     * @allow (create, update, delete) - Only the owner can modify device data.
     * @deny (create, update, delete) - If not authenticated or not the owner.
     */
    match /air_purifier_devices/{deviceId} {
      function isSignedIn() {
        return request.auth != null;
      }
      // NOTE: This is a placeholder.  In a real application, we would check for device ownership.
      function isDeviceOwner() {
          return false; // TODO: Replace with actual device ownership logic (e.g., checking a members map or ownerId field).
      }
      function isExistingDeviceOwner() {
        return isSignedIn() && isDeviceOwner() && resource != null;
      }

      allow get, list: if true;
      allow create: if isSignedIn() && isDeviceOwner(); // TODO: Implement proper owner check on create.
      allow update: if isExistingDeviceOwner();
      allow delete: if isExistingDeviceOwner();
    }

    /**
     * @description Controls access to user-specific air purifier settings.
     * @path /users/{userId}/air_purifier_settings/{settingId}
     * @allow (create, get, list, update, delete) - Only the authenticated user can access their own settings.
     * @deny (create, get, list, update, delete) - If not authenticated or trying to access another user's settings.
     * @principle Enforces user ownership of settings data.
     */
    match /users/{userId}/air_purifier_settings/{settingId} {
      // Helper function to check if the user is signed in and owns the document.
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isSignedIn() && isOwner(userId) && resource != null;
      }
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to air quality predictions for a sensor.
     * @path /sensors/{sensorId}/predictions/{predictionId}
     * @allow (get, list) - Anyone can read air quality predictions.
     * @allow (create, update, delete) - Only the owner of the sensor can modify predictions.
     * @deny (create, update, delete) - If not authenticated or not the owner of the sensor.
     * @principle Public read, owner-only write for air quality predictions, inheriting sensor's ownership.
     */
    match /sensors/{sensorId}/predictions/{predictionId} {
      function isSignedIn() {
        return request.auth != null;
      }
      // NOTE: This is a placeholder.  In a real application, we would check for sensor ownership.
      function isSensorOwner() {
        return false; // TODO: Replace with actual sensor ownership logic (e.g., checking a members map or ownerId field).
      }
      function isExistingSensorOwner() {
        return isSignedIn() && isSensorOwner() && resource != null;
      }
      allow get, list: if true;
      allow create: if isSignedIn() && isSensorOwner(); // TODO: Implement proper owner check on create.
      allow update: if isExistingSensorOwner();
      allow delete: if isExistingSensorOwner();
    }
  }
}