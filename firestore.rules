/**
 * @file Firebase Security Rules for AirView Firestore Database
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model for user profiles and air purifier settings.
 * Sensors, devices, readings, and predictions can be made public by removing authentication requirements from reads and writes.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile data, accessible only to the user themselves.
 * - /sensors/{sensorId}: Stores sensor data.
 * - /sensors/{sensorId}/readings/{readingId}: Stores air quality readings for each sensor.
 * - /air_purifier_devices/{deviceId}: Stores air purifier device information and state.
 * - /users/{userId}/air_purifier_settings/{settingId}: Stores user-specific air purifier settings.
 * - /sensors/{sensorId}/predictions/{predictionId}: Stores air quality predictions for each sensor.
 *
 * Key Security Decisions:
 * - Strict user-ownership for user profiles and air purifier settings.
 * - Open access to sensors, devices, readings, and predictions.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows only the authenticated user to read and write their own user profile.
     * @path /users/{userId}
     * @allow (create) request.auth.uid == 'user_abc'
     * @allow (get) request.auth.uid == 'user_abc'
     * @allow (update) request.auth.uid == 'user_abc'
     * @allow (delete) request.auth.uid == 'user_abc'
     * @deny (create) request.auth.uid != 'user_abc'
     * @deny (get) request.auth.uid != 'user_abc'
     * @deny (update) request.auth.uid != 'user_abc'
     * @deny (delete) request.auth.uid != 'user_abc'
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get: if true;
      allow list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    /**
     * @description Allows anyone to read and write sensor data.
     * @path /sensors/{sensorId}
     * @allow (get) true
     * @allow (list) true
     * @allow (create) true
     * @allow (update) true
     * @allow (delete) true
     * @principle Allows public read access.
     */
    match /sensors/{sensorId} {
      allow get: if true;
      allow list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    /**
     * @description Allows anyone to read and write air quality readings for a specific sensor.
     * @path /sensors/{sensorId}/readings/{readingId}
     * @allow (get) true
     * @allow (list) true
     * @allow (create) true
     * @allow (update) true
     * @allow (delete) true
     * @principle Allows public read access.
     */
    match /sensors/{sensorId}/readings/{readingId} {
      allow get: if true;
      allow list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    /**
     * @description Allows anyone to read and write air purifier device data.
     * @path /air_purifier_devices/{deviceId}
     * @allow (get) true
     * @allow (list) true
     * @allow (create) true
     * @allow (update) true
     * @allow (delete) true
     * @principle Allows public read access.
     */
    match /air_purifier_devices/{deviceId} {
      allow get: if true;
      allow list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    /**
     * @description Allows only the authenticated user to manage their own air purifier settings.
     * @path /users/{userId}/air_purifier_settings/{settingId}
     * @allow (create) request.auth.uid == 'user_abc'
     * @allow (get) request.auth.uid == 'user_abc'
     * @allow (update) request.auth.uid == 'user_abc'
     * @allow (delete) request.auth.uid == 'user_abc'
     * @deny (create) request.auth.uid != 'user_abc'
     * @deny (get) request.auth.uid != 'user_abc'
     * @deny (update) request.auth.uid != 'user_abc'
     * @deny (delete) request.auth.uid != 'user_abc'
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/air_purifier_settings/{settingId} {
      allow get: if true;
      allow list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    /**
     * @description Allows anyone to read and write air quality predictions for a specific sensor.
     * @path /sensors/{sensorId}/predictions/{predictionId}
     * @allow (get) true
     * @allow (list) true
     * @allow (create) true
     * @allow (update) true
     * @allow (delete) true
     * @principle Allows public read access.
     */
    match /sensors/{sensorId}/predictions/{predictionId} {
      allow get: if true;
      allow list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }
  }
}